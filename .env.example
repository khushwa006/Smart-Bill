# ---- Java backend (Render). Placeholders only; never commit real values.
# Spring needs a JDBC URL, NOT the raw postgresql:// URI Neon shows.
DATABASE_URL=jdbc:postgresql://<pooled-host>.neon.tech/<dbname>?sslmode=require
DATABASE_USERNAME=<neon-role>
DATABASE_PASSWORD=<neon-password>
# Flyway should use the DIRECT (non-pooled) host:
FLYWAY_URL=jdbc:postgresql://<direct-host>.neon.tech/<dbname>?sslmode=require
JWT_SECRET=<32+ random bytes, base64>
FRONTEND_ORIGIN=https://<your-app>.vercel.app
PREDICTION_SERVICE_URL=https://<prediction-service>.onrender.com
PREDICTION_SERVICE_TOKEN=<random token>
APP_TIMEZONE=Asia/Kolkata
PORT=8080
# ---- Frontend (Vercel). Public values only.
VITE_API_BASE_URL=https://<your-backend>.onrender.com
# ---- Added in Stage 2
JWT_TTL_MINUTES=480
COOKIE_SECURE=true        # false ONLY for local http://localhost development
SWAGGER_ENABLED=true      # set false in production if you do not want public API docs
DB_POOL_MAX=5
# ---- Added in Stage 3
NATIVE_ENGINE_PATH=/opt/smartbill/schedule-engine   # set automatically by the Dockerfile
NATIVE_ENGINE_TIMEOUT_MS=2000
# ---- Added in Stage 4 (prediction service, Python)
PREDICTION_TIMEOUT_MS=8000
# Python service itself:  PREDICTION_SERVICE_TOKEN (same value as the Java side), PORT, LOG_LEVEL=INFO, ENABLE_DOCS=false
# ---- Added in Stage 5
SCHEDULER_ENABLED=true        # hourly reminder job; safe on multiple instances (idempotent)
APP_DEMO_ENABLED=false        # true once to create the demo user; requires DEMO_PASSWORD
DEMO_PASSWORD=                # YOUR choice, min 8 chars. Never a shared/default password.
